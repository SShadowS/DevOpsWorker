# dependencies
node_modules

# build output
out
dist
*.tgz
src/dashboard/dist/

# code coverage
coverage
*.lcov

# logs
logs
*.log

# dotenv (never commit real secrets)
.env
.env.*.local
# Backups made before a config change are byte copies of .env, secrets included.
# Not covered by the patterns above, and `.env.*` cannot be used because
# `.env.example` is tracked. Without this a reflexive `git add .` sweeps real
# credentials into a PUBLIC repo.
.env.bak*
.env.backup*
.env.*.bak

# caches
.eslintcache
.cache
*.tsbuildinfo

# IDE / OS
.idea
.DS_Store

# local Claude Code state
.claude/settings.local.json
.claude/worktrees/

# pipeline state (contains work item data)
.pipeline/

# worktrees
.worktrees/

# database backups
backups/

# A/B test results
scripts/ab-results/

.mcp.json

# private overlay — proprietary/site-specific content lives in a separate overlay
# repo cloned to ./private (see README "Private Overlay"). Never committed here.
/private/

# internal design docs (specs, plans, status) live in the private overlay at
# private/internal-docs/. They reference site-specific internals and must never be
# committed to this public repo — ignored here so they cannot be added by accident.
/docs/superpowers/

# Spec-driven-development working directory: plans, progress ledgers and review
# notes for in-flight work. Same class of content as /docs/superpowers/ and worse
# in one respect — a ledger records batch ids, database rows and measured spend,
# and dollar figures say something real about the owner's operating costs to
# anyone reading a public repo. It was protected only by a machine-local
# .git/info/exclude, which does not travel with a clone: a fresh workspace would
# have offered the whole directory to `git add .`.
/.superpowers/

# deployment-local Claude Code guidance (site-specific: internal repos, tools,
# environments). Loads automatically at the workspace root. Never commit it here.
/CLAUDE.local.md

# Screenshots and screen recordings. Browser tooling writes them to the repo root by
# default, and a dashboard capture carries real work-item titles, branch names and
# customer-facing text into a PUBLIC repo. One landed here untracked-but-committable before
# this rule existed, where a reflexive `git add .` would have published it. Ignored at the
# root only — an intentionally committed image under docs/ or elsewhere still works.
#
# .gif is not decoration: the browser tooling in use records interaction GIFs, so a
# recording leaks strictly more than the still that prompted this rule. .svg because a
# rendered chart or diagram dropped at the root carries the same text.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
/*.svg

# Design detector: the shared config is committed, its dedup cache is per-machine
.impeccable/hook.cache.json
